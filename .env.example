# App
APP_NAME=AI CCTV Surveillance
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Security
SECRET_KEY=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (SQLite for rapid development)
DB_URL=sqlite:///./data/sqlite/cctv.db
DB_ECHO=false

# CCTV / Video
DEFAULT_CAMERA_SOURCE=0
VIDEO_FRAME_WIDTH=1280
VIDEO_FRAME_HEIGHT=720
PROCESS_EVERY_N_FRAMES=2

# YOLO
YOLO_MODEL_PATH=./data/models/yolo/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_IOU_THRESHOLD=0.50

# Face Recognition
FACE_MODEL=hog
FACE_TOLERANCE=0.50
KNOWN_FACES_DIR=./data/raw/known_faces
UNKNOWN_FACES_DIR=./data/raw/unknown_faces

# Event Logging
EVENT_SNAPSHOT_DIR=./data/snapshots
EVENT_LOG_LEVEL=INFO
EVENT_RETENTION_DAYS=30

# AI Reports
REPORT_OUTPUT_DIR=./data/reports
REPORT_SCHEDULE_CRON=0 0 * * *
REPORT_INCLUDE_HEATMAP=true

# Dashboard
DASHBOARD_REFRESH_SECONDS=5
DASHBOARD_ITEMS_PER_PAGE=20

# Optional External Integrations
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_TO_EMAIL=

# Alert Throttling & Deduplication
ALERT_COOLDOWN_SECONDS=60
# ALERT_DIGEST_MINUTES=5

# Camera Validation
ALLOW_LOCAL_RTSP=false
